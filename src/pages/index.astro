---
import GameLayout from '../layouts/GameLayout.astro';
---
<GameLayout title="Lukas Plants vs Toby Zombies">
  <div class="flex flex-col items-center gap-8 relative min-h-screen px-4">
    <!-- Background split -->
    <div class="fixed inset-0 flex -z-10">
      <div class="w-1/2 bg-cover bg-center opacity-20" style="background-image: url('/assets/landing/bg-plants.png')"></div>
      <div class="w-1/2 bg-cover bg-center opacity-20" style="background-image: url('/assets/landing/bg-zombies.png')"></div>
    </div>

    <!-- Logo -->
    <img src="/assets/landing/logo.png" alt="Lukas Plants vs Toby Zombies" class="w-60 md:w-80 h-auto drop-shadow-2xl" />

    <p class="text-xl text-gray-400">Who are you?</p>

    <div class="flex flex-col md:flex-row gap-4 md:gap-6">
      <!-- Lukas / Plants -->
      <a href="/lobby?player=lukas"
         class="group flex flex-col items-center gap-4 p-6 border-4 border-green-700 rounded-xl bg-green-950/60 hover:bg-green-900/70 hover:border-green-400 transition-all cursor-pointer w-full md:w-80 backdrop-blur-sm">
        <img src="/assets/landing/lukas-portrait.png" alt="Lukas"
             class="w-48 h-48 rounded-lg object-cover group-hover:scale-105 transition-transform shadow-lg shadow-green-900/50" />
        <span class="text-2xl font-bold text-green-400">LUKAS</span>
        <span class="text-sm text-green-600">Ready for Battle</span>
      </a>

      <!-- Toby -->
      <a href="/lobby?player=toby"
         class="group flex flex-col items-center gap-4 p-6 border-4 border-purple-700 rounded-xl bg-purple-950/60 hover:bg-purple-900/70 hover:border-purple-400 transition-all cursor-pointer w-full md:w-80 backdrop-blur-sm">
        <img src="/assets/landing/toby-portrait.png" alt="Toby"
             class="w-48 h-48 rounded-lg object-cover group-hover:scale-105 transition-transform shadow-lg shadow-purple-900/50" />
        <span class="text-2xl font-bold text-purple-400">TOBY</span>
        <span class="text-sm text-purple-600">Ready for Battle</span>
      </a>
    </div>
  </div>
</GameLayout>
