---
import GameLayout from '../layouts/GameLayout.astro';
---
<GameLayout title="Lobby — Lukas Plants vs Toby Zombies">
  <div id="lobby" class="flex flex-col items-center gap-8">
    <!-- Player portrait -->
    <img id="player-portrait" src="/assets/portraits/lukas-lobby.png" alt="Player"
         class="w-32 h-32 md:w-48 md:h-48 rounded-xl object-cover shadow-lg" />

    <h2 class="text-2xl md:text-3xl font-bold" id="welcome-text">Loading...</h2>

    <!-- Faction selector -->
    <div class="flex gap-3 items-center">
      <span class="text-sm text-gray-400">Play as:</span>
      <button id="btn-plants" class="px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-green-700 text-white">Plants</button>
      <button id="btn-zombies" class="px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-gray-700 text-gray-400">Zombies</button>
    </div>

    <div class="flex flex-col items-center gap-4">
      <div id="opponent-status" class="text-lg text-gray-400">
        Checking opponent status...
      </div>

      <div class="flex flex-col md:flex-row gap-3 md:gap-4 mt-8 flex-wrap justify-center">
        <a id="btn-campaign" href="#"
           class="px-10 py-5 bg-green-700 hover:bg-green-600 rounded-lg text-2xl font-bold transition-colors">
          Campaign
        </a>

        <a id="btn-ai" href="#"
           class="px-10 py-5 bg-gray-700 hover:bg-gray-600 rounded-lg text-2xl font-bold transition-colors">
          Play vs AI
        </a>

        <a id="btn-freeplay" href="#"
           class="px-10 py-5 bg-amber-800 hover:bg-amber-700 rounded-lg text-2xl font-bold transition-colors">
          Free Play
        </a>

        <button id="btn-multiplayer" disabled
                class="px-10 py-5 bg-gray-800 rounded-lg text-2xl font-bold text-gray-500 cursor-not-allowed transition-colors">
          Battle Opponent!
        </button>
      </div>

      <!-- Campaign progress -->
      <div id="campaign-info" class="text-center mt-4">
        <span id="campaign-level" class="text-sm text-gray-400"></span>
        <span class="mx-2 text-gray-600">|</span>
        <span id="toby-dollars" class="text-sm text-yellow-400 font-bold"></span>
      </div>

      <!-- Marketplace -->
      <div id="marketplace" class="mt-8 w-full max-w-2xl mx-auto">
        <h3 class="text-xl font-bold text-center mb-4 text-yellow-400">Marketplace</h3>
        <div id="upgrade-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
      </div>
    </div>

    <a href="/" class="text-sm text-gray-500 hover:text-gray-300 mt-8">&larr; Back to character select</a>
  </div>

  <script>
    // Show errors on screen for debugging
    window.onerror = (msg, src, line, col, err) => {
      const el = document.createElement('pre');
      el.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;background:red;color:white;padding:16px;font-size:14px;white-space:pre-wrap';
      el.textContent = `LOBBY ERROR: ${msg}\n${src}:${line}:${col}\n${err?.stack || ''}`;
      document.body.appendChild(el);
    };

    import { goOnline, watchOpponent, type Player } from '../firebase/presence';
    import { createGameRoom, joinRoom, watchRoom, sendChallenge, watchChallenge, clearChallenge, storeFactionInRoom } from '../firebase/multiplayer';
    import { loadSave, saveSave, getUpgradeCost, getUpgradeMultipliers } from '../game/SaveManager';
    import { UNIT_STATS, UNIT_COSTS, UNIT_UNLOCK_LEVELS } from '../game/constants';

    const params = new URLSearchParams(window.location.search);
    const player = params.get('player') as Player | null;

    if (!player || (player !== 'lukas' && player !== 'toby')) {
      window.location.href = '/';
    }

    const opponent: Player = player === 'lukas' ? 'toby' : 'lukas';
    const opponentName = opponent === 'lukas' ? 'Lukas' : 'Toby';
    const playerName = player === 'lukas' ? 'Lukas' : 'Toby';

    document.getElementById('welcome-text')!.textContent = `Welcome, ${playerName}!`;

    // Set player portrait
    const portrait = document.getElementById('player-portrait') as HTMLImageElement;
    portrait.src = `/assets/portraits/${player}-lobby.png`;
    portrait.alt = playerName;

    try { goOnline(player!); } catch (e) { console.warn('Firebase presence unavailable:', e); }

    // Faction state — player can choose plants or zombies
    let selectedFaction: 'plants' | 'zombies' = 'plants';
    const btnPlants = document.getElementById('btn-plants')!;
    const btnZombies = document.getElementById('btn-zombies')!;

    function updateFactionUI(): void {
      if (selectedFaction === 'plants') {
        btnPlants.className = 'px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-green-700 text-white';
        btnZombies.className = 'px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-gray-700 text-gray-400';
      } else {
        btnPlants.className = 'px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-gray-700 text-gray-400';
        btnZombies.className = 'px-5 py-2 rounded-lg text-lg font-bold transition-colors bg-purple-700 text-white';
      }
      updateLinks();
      renderMarketplace();
    }

    function updateLinks(): void {
      const f = selectedFaction;
      const save = loadSave(player!);
      document.getElementById('btn-ai')!.setAttribute('href', `/battle?mode=ai&player=${player}&faction=${f}`);
      document.getElementById('btn-freeplay')!.setAttribute('href', `/battle?mode=freeplay&player=${player}&faction=${f}`);
      document.getElementById('btn-campaign')!.setAttribute('href', `/battle?mode=campaign&player=${player}&faction=${f}&level=${save.currentLevel}`);
      document.getElementById('campaign-level')!.textContent = `Level ${save.currentLevel}/20`;
      document.getElementById('toby-dollars')!.textContent = `${save.tobyDollars} Toby Dollars`;
    }

    btnPlants.addEventListener('click', () => { selectedFaction = 'plants'; updateFactionUI(); });
    btnZombies.addEventListener('click', () => { selectedFaction = 'zombies'; updateFactionUI(); });

    // Initial setup
    const save = loadSave(player!);
    updateLinks();

    // Marketplace — show ALL units, faction determines which you play
    const allUnitKeys = [
      'peashooter', 'sunflower', 'walnutBomb', 'potatoMine', 'cherryBomber',
      'avocadoBunker', 'mangoPult', 'kernelPult', 'pumpkinSquash', 'torchwood',
      'brainEater', 'veryFastWalker', 'skeletonWarrior', 'skeletonArcher',
      'necromancer', 'hotTopic', 'tridentZombie', 'desertZombie', 'cowboyZombie', 'brainRot',
    ];

    const unitLabels: Record<string, string> = {
      peashooter: 'Peashooter', sunflower: 'Sunflower', walnutBomb: 'WalnutBomb',
      potatoMine: 'PotatoMine', cherryBomber: 'CherryBomb', avocadoBunker: 'AvoBunker',
      mangoPult: 'MangoPult', kernelPult: 'KernelPult', pumpkinSquash: 'PumpSquash',
      torchwood: 'Torchwood',
      brainEater: 'BrainEater', veryFastWalker: 'FastWalker', skeletonWarrior: 'SkelWarrior',
      skeletonArcher: 'SkelArcher', necromancer: 'Necromancer', hotTopic: 'HotTopic',
      tridentZombie: 'Trident', desertZombie: 'Desert', cowboyZombie: 'Cowboy',
      brainRot: 'BrainRot',
    };

    function renderMarketplace(): void {
      const currentSave = loadSave(player!);
      const grid = document.getElementById('upgrade-grid')!;
      grid.innerHTML = '';

      document.getElementById('toby-dollars')!.textContent = `${currentSave.tobyDollars} Toby Dollars`;

      for (const unitKey of allUnitKeys) {
        const unlockLevel = UNIT_UNLOCK_LEVELS[unitKey] ?? 1;
        const isLocked = currentSave.currentLevel < unlockLevel;
        const level = currentSave.upgrades[unitKey] ?? 0;
        const maxed = level >= 10;
        const cost = getUpgradeCost(level);
        const canAfford = currentSave.tobyDollars >= cost;
        const stats = UNIT_STATS[unitKey];
        const { hpMult, damageMult } = getUpgradeMultipliers(level);

        const card = document.createElement('div');
        card.className = isLocked
          ? 'bg-gray-900 rounded-lg p-3 flex flex-col items-center gap-2 opacity-50'
          : 'bg-gray-800 rounded-lg p-3 flex flex-col items-center gap-2';

        const name = document.createElement('div');
        name.className = 'font-bold text-sm';
        name.textContent = isLocked
          ? `🔒 ${unitLabels[unitKey] || unitKey}`
          : (unitLabels[unitKey] || unitKey);
        card.appendChild(name);

        const levelText = document.createElement('div');
        levelText.className = 'text-xs text-gray-400';
        levelText.textContent = `Lvl ${level}/10`;
        card.appendChild(levelText);

        const statsText = document.createElement('div');
        statsText.className = 'text-xs text-gray-500';
        statsText.textContent = `HP: ${Math.round(stats.hp * hpMult)} | DMG: ${Math.round(stats.damage * damageMult)}`;
        card.appendChild(statsText);

        if (isLocked) {
          const lockLabel = document.createElement('div');
          lockLabel.className = 'mt-1 text-xs text-gray-500';
          lockLabel.textContent = `Unlocks at Level ${unlockLevel}`;
          card.appendChild(lockLabel);
        } else if (!maxed) {
          const btn = document.createElement('button');
          btn.className = canAfford
            ? 'mt-1 px-3 py-1 bg-yellow-600 hover:bg-yellow-500 rounded text-xs font-bold transition-colors'
            : 'mt-1 px-3 py-1 bg-gray-700 rounded text-xs font-bold text-gray-500 cursor-not-allowed';
          btn.textContent = `Upgrade (${cost} TD)`;
          btn.disabled = !canAfford;

          if (canAfford) {
            btn.addEventListener('click', () => {
              const s = loadSave(player!);
              const currentLvl = s.upgrades[unitKey] ?? 0;
              const c = getUpgradeCost(currentLvl);
              if (s.tobyDollars >= c && currentLvl < 10) {
                s.tobyDollars -= c;
                s.upgrades[unitKey] = currentLvl + 1;
                saveSave(player!, s);
                renderMarketplace();
              }
            });
          }

          card.appendChild(btn);
        } else {
          const maxLabel = document.createElement('div');
          maxLabel.className = 'mt-1 text-xs text-green-400 font-bold';
          maxLabel.textContent = 'MAX';
          card.appendChild(maxLabel);
        }

        grid.appendChild(card);
      }
    }

    renderMarketplace();

    const btnMultiplayer = document.getElementById('btn-multiplayer') as HTMLButtonElement;
    const statusEl = document.getElementById('opponent-status')!;

    try { watchOpponent(player!, (online) => {
      if (online) {
        statusEl.innerHTML = `<span class="text-green-400">${opponentName} is ONLINE!</span>`;
        btnMultiplayer.disabled = false;
        btnMultiplayer.className = 'px-10 py-5 bg-red-700 hover:bg-red-600 rounded-lg text-2xl font-bold cursor-pointer transition-colors';
        btnMultiplayer.textContent = `Battle ${opponentName}!`;
      } else {
        statusEl.innerHTML = `<span class="text-gray-500">${opponentName} is offline</span>`;
        btnMultiplayer.disabled = true;
        btnMultiplayer.className = 'px-10 py-5 bg-gray-800 rounded-lg text-2xl font-bold text-gray-500 cursor-not-allowed transition-colors';
        btnMultiplayer.textContent = 'Battle Opponent!';
      }
    });

    } catch (e) { console.warn('watchOpponent failed:', e); }

    // Watch for incoming challenges
    try { watchChallenge(player!, (challenge) => {
      if (challenge) {
        statusEl.innerHTML = `<span class="text-yellow-400">${challenge.from === 'lukas' ? 'Lukas' : 'Toby'} wants to battle!</span>`;
        btnMultiplayer.disabled = false;
        btnMultiplayer.className = 'px-10 py-5 bg-yellow-600 hover:bg-yellow-500 rounded-lg text-2xl font-bold cursor-pointer transition-colors animate-pulse';
        btnMultiplayer.textContent = 'Accept Challenge!';

        // Override click handler to accept challenge — get opposite faction from challenger
        btnMultiplayer.onclick = () => {
          const challengerFaction = (challenge as any).faction || 'plants';
          const myFaction = challengerFaction === 'plants' ? 'zombies' : 'plants';
          joinRoom(challenge.roomId, player!);
          storeFactionInRoom(challenge.roomId, player!, myFaction);
          clearChallenge(player!);
          window.location.href = `/battle?mode=multiplayer&player=${player}&faction=${myFaction}&room=${challenge.roomId}`;
        };
      }
    }); } catch (e) { console.warn('watchChallenge failed:', e); }

    btnMultiplayer.addEventListener('click', () => {
      if (btnMultiplayer.disabled) return;
      const roomId = createGameRoom();
      joinRoom(roomId, player!);
      storeFactionInRoom(roomId, player!, selectedFaction);
      sendChallenge(player!, roomId, selectedFaction);

      // Show waiting state
      btnMultiplayer.disabled = true;
      btnMultiplayer.textContent = 'Waiting for opponent...';
      btnMultiplayer.className = 'px-10 py-5 bg-gray-600 rounded-lg text-2xl font-bold text-gray-300 cursor-wait transition-colors';

      // Watch for opponent to join
      watchRoom(roomId, (room) => {
        if (room) {
          const opponentKey = player === 'lukas' ? 'toby' : 'lukas';
          if (room[opponentKey]?.ready) {
            window.location.href = `/battle?mode=multiplayer&player=${player}&faction=${selectedFaction}&room=${roomId}`;
          }
        }
      });
    });
  </script>
</GameLayout>
